#!/usr/bin/env python3
"""Promote an immutable Rez package version between package stages."""

from __future__ import annotations

import argparse

from studio_rez.promotion import promote_package


def main() -> int:
    parser = argparse.ArgumentParser(description="Promote a studio Rez package version.")
    parser.add_argument("name", help="Package name, for example usd.")
    parser.add_argument("version", help="Package version, for example 26.05.")
    parser.add_argument("source_stage", choices=("dev", "test", "prod", "archive"))
    parser.add_argument("dest_stage", choices=("dev", "test", "prod", "archive"))
    parser.add_argument("--dry-run", action="store_true", help="Preview promotion without changing files.")
    args = parser.parse_args()

    try:
        result = promote_package(args.name, args.version, args.source_stage, args.dest_stage, dry_run=args.dry_run)
    except Exception as exc:  # noqa: BLE001 - command-line tool should show concise failures.
        print(f"FAIL: {exc}")
        return 1

    action = "Would promote" if args.dry_run else "Promoted"
    print(f"{action} {result['name']}-{result['version']} from {result['source']} to {result['destination']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
