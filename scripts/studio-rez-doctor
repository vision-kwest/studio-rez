#!/usr/bin/env python3
"""Check the local studio Rez environment."""

from __future__ import annotations

import argparse
import importlib.util
import os
import sys
from pathlib import Path

from studio_rez import paths


def status(ok: bool, label: str, detail: str = "") -> bool:
    mark = "PASS" if ok else "FAIL"
    print(f"[{mark}] {label}{': ' + detail if detail else ''}")
    return ok


def is_writable(path: Path) -> bool:
    """Return whether an existing path is writable by the current process."""
    return os.access(path, os.W_OK)


def main() -> int:
    parser = argparse.ArgumentParser(description="Check the studio Rez environment.")
    parser.add_argument("--soft", action="store_true", help="Warn instead of failing when package roots or Rez are unavailable.")
    args = parser.parse_args()

    checks: list[bool] = []
    checks.append(status(sys.version_info >= (3, 10), "Python 3.10+", sys.version.split()[0]))

    rez_available = importlib.util.find_spec("rez") is not None
    checks.append(status(rez_available or args.soft, "Rez import availability", "available" if rez_available else "not importable"))

    rez_config = os.environ.get("REZ_CONFIG_FILE")
    config_ok = bool(rez_config) and Path(rez_config).exists()
    checks.append(status(config_ok, "REZ_CONFIG_FILE", rez_config or "not set"))

    rez_packages_path = os.environ.get("REZ_PACKAGES_PATH")
    checks.append(status(bool(rez_packages_path), "REZ_PACKAGES_PATH", rez_packages_path or "not set"))

    for stage, root in (
        ("dev", paths.dev_root()),
        ("test", paths.test_root()),
        ("prod", paths.prod_root()),
        ("archive", paths.archive_root()),
    ):
        exists = root.exists() and root.is_dir()
        checks.append(status(exists or args.soft, f"{stage} root exists", str(root)))
        if exists:
            checks.append(status(is_writable(root) or stage == "prod" or args.soft, f"{stage} root writable", str(root)))
        else:
            print(f"[INFO] {stage} root writable: skipped because directory is missing")

    if all(checks):
        print("studio-rez doctor: all required checks passed")
        return 0
    print("studio-rez doctor: one or more checks failed")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
