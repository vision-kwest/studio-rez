#!/usr/bin/env python3
"""Check the local studio Rez environment."""

from __future__ import annotations

import argparse
import importlib
import os
import shutil
import sys
from pathlib import Path

from studio_rez import paths


def status(ok: bool, label: str, detail: str = "") -> bool:
    mark = "PASS" if ok else "FAIL"
    print(f"[{mark}] {label}{': ' + detail if detail else ''}")
    return ok


def report(level: str, label: str, detail: str = "") -> None:
    print(f"[{level}] {label}{': ' + detail if detail else ''}")


def suggested_rez_fix() -> str:
    return "\n".join(
        [
            "python3 -m venv /opt/studio/rez/venv",
            "source /opt/studio/rez/venv/bin/activate",
            "pip install rez",
            "export PATH=/opt/studio/rez/venv/bin:$PATH",
        ]
    )


def dependency_check(ok: bool, label: str, detail: str, soft: bool) -> bool:
    """Report a required Rez dependency, warning instead of failing in soft mode."""
    if ok:
        return status(True, label, detail)
    if soft:
        report("WARN", label, detail)
        return True
    return status(False, label, detail)


def can_import_rez() -> bool:
    try:
        importlib.import_module("rez")
    except ImportError:
        return False
    return True


def check_rez_dependencies(soft: bool) -> list[bool]:
    """Check Rez CLIs and Python module availability."""
    rez_command = shutil.which("rez")
    rez_env_command = shutil.which("rez-env")
    rez_importable = can_import_rez()

    checks = [
        dependency_check(
            rez_command is not None,
            "rez command availability",
            "available" if rez_command else "not found on PATH",
            soft,
        ),
        dependency_check(
            rez_env_command is not None,
            "rez-env command availability",
            "available" if rez_env_command else "not found on PATH",
            soft,
        ),
        dependency_check(
            rez_importable,
            "Rez Python import availability",
            "available" if rez_importable else "not importable",
            soft,
        ),
    ]
    if not rez_command or not rez_env_command or not rez_importable:
        report("INFO", "Suggested Rez install/fix", "run the following commands")
        print(suggested_rez_fix())
    return checks


def is_writable(path: Path) -> bool:
    """Return whether an existing path is writable by the current process."""
    return os.access(path, os.W_OK)


def check_stage_root(stage: str, root: Path, soft: bool) -> bool:
    """Report existence and writability for one package stage root."""
    if not root.exists() or not root.is_dir():
        if soft:
            report("WARN", f"{stage} root missing", str(root))
            return True
        return status(False, f"{stage} root exists", str(root))

    ok = status(True, f"{stage} root exists", str(root))
    if soft:
        report("INFO", f"{stage} root writable", "skipped in --soft mode")
        return ok
    return status(is_writable(root) or stage == "prod", f"{stage} root writable", str(root))


def main() -> int:
    parser = argparse.ArgumentParser(description="Check the studio Rez environment.")
    parser.add_argument("--soft", action="store_true", help="Warn instead of failing when package roots or Rez are unavailable.")
    args = parser.parse_args()

    package_root = paths.package_root()
    stage_roots = {
        "dev": paths.dev_root(),
        "test": paths.test_root(),
        "prod": paths.prod_root(),
        "archive": paths.archive_root(),
    }

    report("INFO", "STUDIO_PACKAGE_ROOT", str(package_root))
    for stage, root in stage_roots.items():
        report("INFO", f"{stage} root resolved", str(root))

    checks: list[bool] = []
    checks.append(status(sys.version_info >= (3, 10), "Python 3.10+", sys.version.split()[0]))

    checks.extend(check_rez_dependencies(args.soft))

    rez_config = os.environ.get("REZ_CONFIG_FILE")
    config_ok = bool(rez_config) and Path(rez_config).exists()
    checks.append(status(config_ok, "REZ_CONFIG_FILE", rez_config or "not set"))

    rez_packages_path = os.environ.get("REZ_PACKAGES_PATH")
    checks.append(status(bool(rez_packages_path), "REZ_PACKAGES_PATH", rez_packages_path or "not set"))

    for stage, root in stage_roots.items():
        checks.append(check_stage_root(stage, root, args.soft))

    if all(checks):
        print("studio-rez doctor: all required checks passed")
        return 0
    print("studio-rez doctor: one or more checks failed")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
